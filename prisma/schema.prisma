generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ============================================================
// MODELO DE USUARIO
// ============================================================
model usuarios {
  id                 String   @id @default(uuid()) @db.Uuid
  nombre             String   @db.VarChar(30)
  correo             String   @unique @db.VarChar(255)
  password           String?  @db.VarChar(255)
  avatar             String?  @db.Text
  google_id          String?  @unique @db.VarChar(255)
  discord_id         String?  @unique @db.VarChar(255)
  email_verificado_en DateTime?
  creado_en          DateTime @default(now())
  actualizado_en     DateTime @updatedAt

  // Relación 1:1 con preferencias
  preferencias preferencias?

  @@map("usuarios")
}

// ============================================================
// PREFERENCIAS DE USUARIO
// ============================================================
model preferencias {
  id           String   @id @default(uuid()) @db.Uuid
  usuarioId    String   @unique @map("usuario_id") @db.Uuid
  sfw          Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  // Relación 1:1 con usuario
  usuario usuarios @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("preferencias")
}

// ============================================================
// TOKENS DE RESETEO DE CONTRASEÑA
// ============================================================
model password_reset_tokens {
  email     String   @id
  token     String   @db.VarChar(255)
  usado     Boolean  @default(false)
  creado_en DateTime @default(now())

  @@map("password_reset_tokens")
}

{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "builds": [
    {
      "src": "dist/main.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/catalogo/(hero|temporada|top-anime|top-manga|proximos|noticias)(.*)",
      "headers": {
        "Cache-Control": "public, s-maxage=28800, stale-while-revalidate=86400, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/api/catalogo/(buscar|buscar-global|detalle-anime|detalle-manga|buscar-por-temporada)(.*)",
      "headers": {
        "Cache-Control": "public, s-maxage=300, stale-while-revalidate=600, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/api/auth/(.*)",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "headers": {
        "Cache-Control": "public, s-maxage=300, stale-while-revalidate=600, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "/dist/main.js"
    }
  ]
}